# Copy this file to .appstore_credentials and fill in your App Store Connect API values.
# Keep .appstore_credentials untracked. It is already listed in .gitignore.

ASC_KEY_ID="YOUR_KEY_ID"
ASC_ISSUER_ID="YOUR_ISSUER_ID"

# Required key file location for xcrun altool:
# ~/.appstoreconnect/private_keys/AuthKey_${ASC_KEY_ID}.p8
